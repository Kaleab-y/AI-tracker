# ── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Anthropic (Claude) ───────────────────────────────────────────────
# Required to proxy requests for claude-* models
ANTHROPIC_API_KEY=

# ── Google (Gemini) ──────────────────────────────────────────────────
# Required to proxy requests for gemini-* models
GEMINI_API_KEY=

# ── Database ─────────────────────────────────────────────────────────
# Defaults to a local SQLite file, relative to the backend working directory.
# DATABASE_URL=sqlite:///./telemetry.db
UPSTREAM_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# False opts into LiteLLM's remote pricing catalog refresh at startup.
LITELLM_LOCAL_MODEL_COST_MAP=True
