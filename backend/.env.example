# ── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Anthropic (Claude) ───────────────────────────────────────────────
# Required to proxy requests for claude-* models
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google (Gemini) ──────────────────────────────────────────────────
# Required to proxy requests for gemini-* models
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database ─────────────────────────────────────────────────────────
# Defaults to a local SQLite file. Override for production (e.g. PostgreSQL).
# DATABASE_URL=sqlite:///./telemetry.db
